//                               █       █      █        ▄▀                ▀▄    █          █
//                               █      █       █        █                  █    █          █
//                               █     █        █       █                    █   █          █
//                               █    █         █       █                    █   █▄▄▄▄▄▄▄▄▄▄█
//                               █   █ █        █       █                    █   █      █
//                               █  █   █       █        █                  █    █       █
//                               █ █     █      █        ▀▄                ▄▀    █        █
//                               ██       █     █          ▀▄            ▄▀      █         █
//                               █         █    █▄▄▄▄▄▄▄▄    ▀▀▀▄▄▄▄▄▄▀▀▀        █          █
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/behaviors.h>


// Definitions //

#define base_layer 0
#define lower_layer 1
#define raise_layer 2
#define nav_layer 3

#define _____ &trans
#define slashP &th LS(SLASH) P
#define HYPEReturn &tb LS(LC(LA(LGUI))) RETURN
#define MehSpace &tb LS(LC(LALT)) SPACE


// Combos//
/ {
    combos {
        compatible = "zmk,combos";

        combo_enter {
            timeout-ms = <50>;
            bindings = <&kp RETURN>;
            key-positions = <17 18 19>;
        };

        ctrl-backspace {
            timeout-ms = <50>;
            bindings = <&kp LC(BACKSPACE)>;
            key-positions = <31 32 33>;
        };

        left-parenthesis {
            timeout-ms = <50>;
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <6 7>;
        };

        right-parenthesis {
            timeout-ms = <50>;
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <7 8>;
        };

        left-bracket {
            timeout-ms = <50>;
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <17 18>;
        };

        right-bracket {
            timeout-ms = <50>;
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <18 19>;
        };

        left-brace {
            timeout-ms = <50>;
            bindings = <&kp LEFT_BRACE>;
            key-positions = <31 32>;
        };

        right-brace {
            timeout-ms = <50>;
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <32 33>;
        };

        combo_colon {
            timeout-ms = <50>;
            bindings = <&kp SEMI>;
            key-positions = <19 20>;
        };

        combo_angle {
            timeout-ms = <50>;
            bindings = <&angle_morph>;
            key-positions = <17 19>;
        };

    };

    behaviors {
        HML: HML {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 8 9 16 17 18 19 20 28 29 30 31 32 33 39 40 41>;
        };

        HMR: HMR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36>;
        };

        th: th {
            compatible = "zmk,behavior-hold-tap";
            label = "Taphold";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
        };

        tb: tb {
            compatible = "zmk,behavior-hold-tap";
            label = "Thumb hold";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            // require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
        };

        tc: tc {
          compatible = "zmk,behavior-hold-tap";
          label = "Thumb hold for layer";
          bindings = <&mo>, <&kp>;

          #binding-cells = <2>;
          tapping-term-ms = <280>;
          quick-tap-ms = <175>;
          require-prior-idle-ms = <150>;
          flavor = "tap-preferred";
      };
        
        tb_B: tb_B {
            compatible = "zmk,behavior-tap-dance";
            label = "TB_B";
            #binding-cells = <0>;
            bindings = <&kp B>, <&kp LC(B)>;
            tapping-term-ms = <200>;
        };

        angle_morph: angle_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "angle_morph";
            #binding-cells = <0>;
            bindings = <&kp LT>, <&kp GT>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        GamRT: GamRT {
            compatible = "zmk,behavior-mod-morph";
            label = "GamRT";
            #binding-cells = <0>;
            bindings = <&kp R>, <&kp T>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        GamFG: GamFG {
            compatible = "zmk,behavior-mod-morph";
            label = "GamFG";
            #binding-cells = <0>;
            bindings = <&kp F>, <&kp G>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        GamVB: GamVB {
            compatible = "zmk,behavior-mod-morph";
            label = "GamVB";
            #binding-cells = <0>;
            bindings = <&kp V>, <&kp B>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        GamEI: GamEI {
            compatible = "zmk,behavior-mod-morph";
            label = "GamEI";
            #binding-cells = <0>;
            bindings = <&kp E>, <&kp I>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        vim_left: vim_left {
          compatible = "zmk,behavior-mod-morph";
          label = "vim_left";
          #binding-cells = <0>;
          bindings = <&kp LEFT>, <&kp N0>;
          mods = <(MOD_LSFT | MOD_RSFT)>;
      };
        
        vim_right: vim_right {
          compatible = "zmk,behavior-mod-morph";
          label = "vim_right";
          #binding-cells = <0>;
          bindings = <&kp RIGHT>, <&kp DLLR>;
          mods = <(MOD_LSFT | MOD_RSFT)>;
      };

    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
             bindings = <
                //                ┌───────────────┬───────────────┬───────────────┬───────────────┬───────────────┐                                  ┌───────────────┬───────────────┬───────────────┬───────────────┬───────────────┐
                                       &kp B          &kp L           &kp D           &HML LGUI W     &kp Z                                              &kp SQT         &HMR LGUI F     &kp O            &kp U          &kp J
                //┌───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┐                                  ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┐
                      &TAB            &lt 2 N        &HML LCTRL R    &HML LALT T     &lt 3 S         &kp G                                               &kp Y           &lt 3 H        &HMR LALT A     &HMR LCTRL E     &lt 2 I         &kp COMMA
                //├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤╭───────────────╮╭───────────────╮├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
                      &tog 1           &kp Q          &kp X           &kp M           &kp C           &kp V            &trans            &trans          &kp K           slashP          &kp PERIOD      &kp MINUS       &kp SLASH       &kp ESCAPE 
                //└───────────────┴───────────────┴───────────────┼───────────────┼───────────────┼───────────────┼╰───────────────╯╰───────────────╯┼───────────────┼───────────────┼───────────────┴───────────────┴───────────────┴───────────────┘
                                                      &mo 1           &kp BACKSPACE   &kp LSHIFT      &trans                                             &trans           HYPEReturn      MehSpace        &mo 2
                //                                └───────────────┴───────────────┴───────────────┴───────────────┘                                  └───────────────┴───────────────┴───────────────┴───────────────┘
                >;
            
                sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
         };


        lower_layer {
            label = "Lower";
             bindings = <
                //                ┌───────────────┬───────────────┬───────────────┬───────────────┬───────────────┐                                  ┌───────────────┬───────────────┬───────────────┬───────────────┬───────────────┐
                                      _____           &kp AMPS        &kp STAR        _____           _____                                              _____           &kp N7          &kp N8          &kp N9          &kp N0
                //┌───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┐                                  ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┐
                      _____           &kp ESCAPE      &kp DLLR        &kp PRCNT       &kp CARET       _____                                              _____           &kp N4          &kp N5          &kp N6          _____           _____
                //├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤╭───────────────╮╭───────────────╮├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
                      _____           _____           &kp EXCL        &kp AT          &kp HASH        _____            _____            _____            _____           &kp N1          &kp N2          &kp N3          _____           _____
                //└───────────────┴───────────────┴───────────────┼───────────────┼───────────────┼───────────────┼╰───────────────╯╰───────────────╯┼───────────────┼───────────────┼───────────────┴───────────────┴───────────────┴───────────────┘
                                                      _____           _____           _____           _____                                              _____           _____           _____           _____
                //                                └───────────────┴───────────────┴───────────────┴───────────────┘                                  └───────────────┴───────────────┴───────────────┴───────────────┘
                >;
            
                sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };


        raise_layer {
            label = "Raise";
            bindings = <
                //                ┌───────────────┬───────────────┬───────────────┬───────────────┬───────────────┐                                  ┌───────────────┬───────────────┬───────────────┬───────────────┬───────────────┐
                                      _____           _____           _____           _____           _____                                              &kp F12         &kp F7          &kp F8          &kp F9          _____
                //┌───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┐                                  ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┐
                      _____           &kp ESCAPE      _____           &kp MINUS       &kp EQUAL       _____                                              &kp F11         &kp F4          &kp F5          &kp F6          &kp BSLH        &kp TILDE
                //├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤╭───────────────╮╭───────────────╮├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
                      _____           _____           _____           &kp UNDER       &kp PLUS        _____            _____            _____            &kp F10         &kp F1          &kp F2          &kp F3          &kp PIPE        &kp GRAVE
                //└───────────────┴───────────────┴───────────────┼───────────────┼───────────────┼───────────────┼╰───────────────╯╰───────────────╯┼───────────────┼───────────────┼───────────────┴───────────────┴───────────────┴───────────────┘
                                                      _____           _____           _____           _____                                              _____           _____           _____           _____
                //                                └───────────────┴───────────────┴───────────────┴───────────────┘                                  └───────────────┴───────────────┴───────────────┴───────────────┘
                >;
            
                sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };


        nav_layer {
            label = "Nav";
            bindings = <
                //                ┌───────────────┬───────────────┬───────────────┬───────────────┬───────────────┐                                  ┌───────────────┬───────────────┬───────────────┬───────────────┬───────────────┐
                                      _____           &kp LC(TAB)     &kp DELETE      &kp C_MUTE      &kp PG_UP                                          &kp PG_DN       &kp LC(C)        _____          &kp LC(V)        _____
                //┌───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┐                                  ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┐
                      _____           &kp ESCAPE      &kp TAB         _____           &kp C_VOL_UP     _____                                             &kp LEFT       &kp DOWN         &kp UP          &kp RIGHT      &kp LC(EQUAL)    _____
                //├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤╭───────────────╮╭───────────────╮├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
                      _____           _____           _____           _____           &kp C_VOL_DN     _____            _____            _____            _____           _____          &kp CAPS         _____         &kp LC(MINUS)    _____
                //└───────────────┴───────────────┴───────────────┼───────────────┼───────────────┼───────────────┼╰───────────────╯╰───────────────╯┼───────────────┼───────────────┼───────────────┴───────────────┴───────────────┴───────────────┘
                                                      _____           _____           _____            _____                                              _____           _____           _____           _____
                //                                └───────────────┴───────────────┴───────────────┴───────────────┘                                  └───────────────┴───────────────┴───────────────┴───────────────┘
                >;

                sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;

        };

    };

};
